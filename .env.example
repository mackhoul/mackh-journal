# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Supabase project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Supabase Service Role key (Settings → API → service_role)
# WARNING: this is a secret key — never expose it in frontend code
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Cloudflare R2 (screenshots use this instead of Supabase Storage
# when all 5 are set: 10GB free vs Supabase's 1GB, zero egress fees)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=trade-images
# R2_PUBLIC_URL=

# Port (Render sets this automatically — do not set it manually on Render)
# PORT=3000
